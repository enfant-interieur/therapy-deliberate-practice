{
  "name": "therapy-deliberate-practice",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "node -e \"import(require('node:url').pathToFileURL(require('node:path').join(require('node:child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim(),'scripts/release/wait-for-ci.mjs')).href).then(m=>m.runReleaseCheck()).catch(()=>process.exit(1))\"",
  },
  "send_email": [
    {
      "name": "AUTH_EMAIL",
      "allowed_sender_addresses": [
        "login@auth.therapy-deliberate-practice.com",
      ],
    },
  ],
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "therapy-studio-clean-20261106",
      "database_id": "6e7bb8cf-9fd6-4ab2-a3f1-6192c85685ac",
      "migrations_dir": "migrations",
    },
  ],
  "placement": {
    "mode": "smart",
  },
  "routes": [
    {
      "pattern": "therapy-deliberate-practice.com/*",
      "zone_name": "therapy-deliberate-practice.com",
    },
    {
      "pattern": "www.therapy-deliberate-practice.com/*",
      "zone_name": "therapy-deliberate-practice.com",
    },
  ],
  "r2_buckets": [
    {
      "bucket_name": "therapy-studio-clean-20261106-audio",
      "binding": "deliberate_practice_audio",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "ADMIN_BATCH_PARSE_QUEUE",
        "queue": "therapy-studio-parse-20261106",
      },
      {
        "binding": "PATIENT_AUDIO_QUEUE",
        "queue": "therapy-studio-audio-20261106",
      },
    ],
    "consumers": [
      {
        "queue": "therapy-studio-parse-20261106",
      },
      {
        "queue": "therapy-studio-audio-20261106",
      },
    ],
  },
  // Secrets (set via `wrangler secret put`): OPENAI_API_KEY, OPENAI_KEY_ENCRYPTION_SECRET, AUTH_SECRET,
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET,
  //   APPLE_CLIENT_ID, APPLE_TEAM_ID, APPLE_KEY_ID, APPLE_PRIVATE_KEY,
  //   CF_ACCESS_AUD, CF_ACCESS_ISSUER,
  //    "ADMIN_EMAILS": "",
  //    "ADMIN_GROUPS": "",
  // Local model URLs belong to the learner's browser settings. A hosted Worker cannot reach them.
  "vars": {
    "ENV": "production",
    "AUTH_BASE_URL": "https://therapy-deliberate-practice.com",
    "AUTH_TRUSTED_ORIGINS": "https://www.therapy-deliberate-practice.com",
    "AUTH_EMAIL_FROM": "login@auth.therapy-deliberate-practice.com",
    "AUTH_EMAIL_ENABLED": "false",
    "R2_BUCKET": "therapy-studio-clean-20261106-audio",
    "BYPASS_ADMIN_AUTH": "false",
    "DEV_ADMIN_TOKEN": "",
  },
}
