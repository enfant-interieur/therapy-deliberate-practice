{
  "name": "therapy-deliberate-practice",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "send_email": [{ "name": "AUTH_EMAIL", "allowed_sender_addresses": ["login@auth.therapy-deliberate-practice.com"] }],
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deliberate_practice",
      "database_id": "695c3755-8777-45fc-89b3-41b79e26522b",
      "migrations_dir": "migrations",
    },
  ],
  "placement": {
    "mode": "smart",
  },
  "routes": [
    {
      "pattern": "therapy-deliberate-practice.com/*",
      "zone_name": "therapy-deliberate-practice.com",
    },
    {
      "pattern": "www.therapy-deliberate-practice.com/*",
      "zone_name": "therapy-deliberate-practice.com",
    },
  ],
  "r2_buckets": [
    {
      "bucket_name": "deliberate-practice-audio",
      "binding": "deliberate_practice_audio",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "ADMIN_BATCH_PARSE_QUEUE",
        "queue": "admin-batch-parse"
      },
      {
        "binding": "PATIENT_AUDIO_QUEUE",
        "queue": "patient-audio"
      }
    ],
    "consumers": [
      {
        "queue": "admin-batch-parse"
      },
      {
        "queue": "patient-audio"
      }
    ]
  },
  // Secrets (set via `wrangler secret put`): OPENAI_API_KEY, OPENAI_KEY_ENCRYPTION_SECRET, AUTH_SECRET,
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET,
  //   APPLE_CLIENT_ID, APPLE_TEAM_ID, APPLE_KEY_ID, APPLE_PRIVATE_KEY,
  //   CF_ACCESS_AUD, CF_ACCESS_ISSUER,
  //    "ADMIN_EMAILS": "",
  //    "ADMIN_GROUPS": "",
  // Local model URLs belong to the learner's browser settings. A hosted Worker cannot reach them.
  "vars": {
    "ENV": "production",
    "AUTH_BASE_URL": "https://therapy-deliberate-practice.com",
    "AUTH_TRUSTED_ORIGINS": "https://www.therapy-deliberate-practice.com",
    "AUTH_EMAIL_FROM": "login@auth.therapy-deliberate-practice.com",
    "AUTH_EMAIL_ENABLED": "false",
    "R2_BUCKET": "deliberate-practice-audio",
    "BYPASS_ADMIN_AUTH": "false",
    "DEV_ADMIN_TOKEN": "",
  },
}
