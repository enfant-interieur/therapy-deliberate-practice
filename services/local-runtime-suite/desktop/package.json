{
  "name": "local-runtime-desktop",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "vitest run",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "sidecar:build:force": "node scripts/build-sidecar.mjs --force",
    "tauri": "tauri",
    "tauri:dev": "npm run sidecar:build:force && tauri dev --config src-tauri/tauri.conf.json --config src-tauri/tauri.sidecar.conf.json",
    "tauri:build": "npm run sidecar:build && tauri build --config src-tauri/tauri.conf.json --config src-tauri/tauri.sidecar.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.6",
    "vitest": "^4.1.10"
  }
}
